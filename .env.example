# 复制为 .env 后修改。docker compose 和本地开发共用这一份。
# 只有 POSTGRES_PASSWORD 必填；其余取消注释即可修改，注释中的值就是默认值。

POSTGRES_PASSWORD=change-me

# 运行环境：prod 或 dev。dev 会在 config/config.yaml 之上再读取 config/config.dev.yaml。
# Docker 中由 docker-compose.yml 固定为 prod，这里的值不影响容器。
# APP_ENV=prod

# 数据库连接，变量名和默认值都与 Postgres 官方镜像一致
# POSTGRES_USER=postgres
# POSTGRES_DB=            （默认与 POSTGRES_USER 相同）
# POSTGRES_HOST=localhost （Docker 中固定为 db）
# POSTGRES_PORT=5432      （本地开发时也是数据库映射到本机的端口）
# POSTGRES_SSLMODE=disable

# JWT 签名密钥。不设置时首次启动自动生成并保存到数据库
# JWT_SECRET=
